{
  "manifest_version": 3,
  "name": "GTA 6 Notifier",
  "version": "1.0.9",
  "description": "Made by Nicknrss. Monitors GitHub Releases and PortWatch VI progress/rankings. / Feita por Nicknrss. Monitora Releases do GitHub e progresso/rankings do PortWatch VI.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://portwatch-vi.xyz/*",
    "https://discord.com/api/webhooks/*",
    "https://*.github.com/*",
    "https://www.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GTA 6 Notifier"
  },
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "options_page": "dashboard.html",
  "homepage_url": "https://github.com/Nicknrss/GTA-6-Notifier"
}
