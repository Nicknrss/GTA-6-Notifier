{
  "manifest_version": 3,
  "name": "GTA 6 Notifier",
  "version": "2.2.0",
  "description": "Monitora novos Releases do GitHub e mudanças de progresso geral e ranking do PortWatch VI.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://portwatch-vi.xyz/*",
    "https://discord.com/api/webhooks/*",
    "https://*.github.com/*",
    "https://www.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "scripts": [
      "locale.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GTA 6 Notifier"
  },
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gta6-notifier@example.com",
      "strict_min_version": "128.0"
    }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  }
}
