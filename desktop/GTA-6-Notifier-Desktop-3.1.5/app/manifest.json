{
  "manifest_version": 3,
  "name": "GTA 6 Notifier",
  "version": "3.1.4",
  "description": "Central multiplataforma para Releases do GitHub e progresso/ranking do PortWatch VI.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://portwatch-vi.xyz/*",
    "https://discord.com/api/webhooks/*",
    "https://*.github.com/*",
    "https://www.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GTA 6 Notifier"
  },
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "options_page": "dashboard.html"
}
